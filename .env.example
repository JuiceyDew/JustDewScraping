# --- Ollama Cloud ---------------------------------------------------------
# PREFER THE WEB UI. The `ideafindr` web UI has a Settings page for the API key,
# model IDs and embeddings config; values entered there are stored in the state
# directory (mode 0600), never in this file or the repo. Anything set in the
# real environment (including a NixOS EnvironmentFile) overrides the UI.
#
# This file is for the environment/Nix path and for non-UI use.
# Get a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Model IDs as Ollama Cloud lists them (no "-cloud" suffix on /v1).
# See the live list with: uv run ideafindr doctor
OLLAMA_BASE_URL=https://ollama.com/v1
FAST_MODEL=gpt-oss:120b
SMART_MODEL=gpt-oss:120b

# Ceiling on completion tokens for one chat call. Lower is cheaper and faster;
# too low makes reasoning models return empty content. Labels are batched, so
# this is not multiplied by the theme count.
LLM_MAX_TOKENS=2048

# --- state ---------------------------------------------------------------
# Where the database, reports, sessions and UI-entered settings live.
# Defaults to <repo>/data. The NixOS module sets this to the systemd
# StateDirectory (/var/lib/ideafindr).
# IDEAFINDR_STATE_DIR=/var/lib/ideafindr

# --- web UI bind ----------------------------------------------------------
# The UI defaults to 0.0.0.0:8000 so it is reachable from the LAN (the
# homelab use case). It has NO app auth and holds your Ollama key and social
# session cookies, so restrict the firewall to your subnet, or front it with a
# VPN / authenticating reverse proxy. The retriever bridge stays on 127.0.0.1.
# WEB_HOST=0.0.0.0
# WEB_PORT=8000

# --- Embeddings -----------------------------------------------------------
# auto = probe your configured provider, then Ollama Cloud, then fall back to
# in-process TF-IDF+SVD. Force one with: api | ollama-cloud | ollama-local | tfidf
#
# Ollama Cloud serves chat but NOT embeddings (/v1/embeddings 404, /api/embed
# 401), so a real embedder means a hosted provider. Any OpenAI-compatible
# /v1/embeddings endpoint works -- Jina and Voyage have free tiers; OpenAI,
# Cohere and Together also work. Set both vars and switch EMBED_BACKEND to
# `auto` (or `api`) to turn it on:
#
#   EMBED_BACKEND=auto
#   EMBED_BASE_URL=https://api.jina.ai/v1
#   EMBED_API_KEY=jina_...
#   EMBED_MODEL=jina-embeddings-v3
#
# Without a provider, clustering uses TF-IDF: fine for social posts, weak for
# short search queries, and `report --engine gpt-researcher` and `ask` stay
# unavailable because both build their own vector store.
EMBED_BACKEND=tfidf
EMBED_MODEL=all-minilm
EMBED_BASE_URL=
EMBED_API_KEY=

# Only used when EMBED_BACKEND=ollama-local explicitly -- never by `auto`,
# which must not route embedding work onto a low-end machine's CPU.
OLLAMA_LOCAL_URL=http://localhost:11434

# --- Reddit -----------------------------------------------------------------
# Reddit's own API allows 100 queries/minute, versus Arctic Shift's ~2/s that
# times out on roughly a fifth of keyword queries. The collector is written and
# tested and switches on automatically once these are set.
#
# GETTING CREDENTIALS IS NO LONGER SELF-SERVICE. Reddit's Responsible Builder
# Policy (November 2025) closed instant signup at reddit.com/prefs/apps. Every
# new request now goes to a manual review queue with no published timeline and
# no appeal process; declines arrive as an automated template with no reason.
# Academic research has a dedicated lane. Commercial requests are routed to
# enterprise sales.
#
# Reddit also PROHIBITS commercial resale or licensing of its data, which covers
# selling a report built on Reddit quotes. Read the policy before applying:
# https://support.reddithelp.com/hc/en-us/articles/42728983564564-Responsible-Builder-Policy
#
# Until (and unless) you are approved, use the sources that need no permission:
#   --sources dork          reddit threads via search-engine snippets
#   --sources reddit        arctic shift (the default fallback)
#   --sources hackernews,lemmy,stackexchange
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Stack Exchange ---------------------------------------------------------
# Optional. 300 requests/day/IP without a key, 10,000 with one (free, from
# stackapps.com). Only used when the planner picks sites for the topic.
STACKEXCHANGE_KEY=

# --- X / Twitter ------------------------------------------------------------
# No API key. twscrape drives X's GraphQL with browser cookies, entered on the
# web UI's Credentials page (auth_token + ct0). Stored in the state dir.
#
#   USE A DEDICATED BURNER ACCOUNT -- never a personal or client one.
#   One account, no proxies: keep the per-run cap low (see collectors/x_twitter).
#
# Only set these in the environment if you are not using the UI.
# X_AUTH_TOKEN=
# X_CT0=

# --- Instagram --------------------------------------------------------------
# Optional, off by default. A logged-in sessionid is entered on the Credentials
# page; without one the collector only finds public posts via web search.
# INSTAGRAM_SESSIONID=
# INSTAGRAM_CSRFTOKEN=

# --- Optional scrapers (ToS-risky, off by default; see README) -------------
ENABLE_TIKTOK=false
ENABLE_INSTAGRAM=false
TIKTOK_MS_TOKEN=
INSTAGRAM_SESSION_USER=
